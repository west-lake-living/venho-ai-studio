[Unit]
Description=Encrypted Growth Engine production backup to Google Drive

[Service]
Type=oneshot
EnvironmentFile=%h/venho/secrets/growth-engine.env
WorkingDirectory=%h/venho/growth-engine/current
ExecStart=%h/venho/growth-engine/current/.venv/bin/venho-engine backup offsite-now
TimeoutStartSec=2h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=%h/venho/state/growth-engine

# Copy into the runtime environment after ComfyUI is installed locally.
VENHO_COMFYUI_ENDPOINT=http://127.0.0.1:8188
VENHO_COMFYUI_WORKFLOW_VERSION=face_restore_v1
# Historical v1 workflow; SUPERSEDED and archived. Do not use as current v2.x authority.
VENHO_COMFYUI_WORKFLOW_PATH=workflows/_archive/face_restore_v1_api.json
VENHO_COMFYUI_TIMEOUT_SECONDS=120
VENHO_COMFYUI_CLIENT_ID=venho-action-composite
# Maps each uploaded asset to the _meta.title of the LoadImage node that consumes it,
# so a new workflow graph never requires an adapter code change.
VENHO_COMFYUI_NODE_BINDINGS={"base":"base_image","mask":"face_mask","reference":"identity_reference"}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.venho.dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-m</string>
    <string>streamlit</string>
    <string>run</string>
    <string>ui/studio_app.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/harry/venho-ai-studio</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/venho.dashboard.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/venho.dashboard.err.log</string>
</dict>
</plist>

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
# Growth Agent M05 social-copy model. Defaults to claude-opus-4-1-20250805
# when omitted. Override only with an Anthropic API model enabled for this key.
CLAUDE_CONTENT_MODEL=claude-opus-4-1-20250805

# Growth Agent v3.1 real providers (feature-flagged off until wired + tested)
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
# Trend Radar classification only (research_engine/trend_radar/classifiers/gemini_classifier.py)
# -- Gemini Flash, not Claude, chosen 2026-08-05 for cost (Anthropic stays in use
# elsewhere in this repo for real content generation, unaffected by this key).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
ZALO_ACCESS_TOKEN=YOUR_ZALO_ACCESS_TOKEN
ZALO_REFRESH_TOKEN=YOUR_ZALO_REFRESH_TOKEN
ZALO_APP_ID=YOUR_ZALO_APP_ID
ZALO_APP_SECRET=YOUR_ZALO_APP_SECRET

# Zalo OA publishing: this repo only fires a webhook -- Make.com's own
# HTTP / Custom API Request module makes the real Zalo OA call after
# "Approve" is clicked on VENHO OS Dashboard (Harry's integration decision,
# 2026-08-03). MAKE_ZALO_WEBHOOK_SECRET is optional (HMAC-signs the payload
# so the Make scenario can verify it came from us).
MAKE_ZALO_WEBHOOK_URL=YOUR_MAKE_COM_ZALO_WEBHOOK_URL
MAKE_ZALO_WEBHOOK_SECRET=YOUR_MAKE_ZALO_WEBHOOK_SECRET

# Facebook/Instagram/Threads publishing: same relay pattern as Zalo above.
# This MUST be a Make.com scenario of its own -- do NOT paste the legacy
# VenHoSocialManager webhook here. That scenario's "HTTP: Get a file" module
# requires a flat `url` field which the growth payload does not have (it sends
# nested `content` + a possibly-null `image_url`), so sharing one webhook made
# every growth dispatch fail Make-side with BundleValidationError (2026-08-04).
# image_url is never null since 2026-08-06 (publishing_gateway/fallback_images.py
# substitutes an on-brand hotel photo), so the growth scenario can map it
# straight into an "HTTP: Download a file" module without a null guard.
# Leave unset -> MakeGatewayAdapter stays disabled and nothing is sent.
MAKE_GROWTH_WEBHOOK_URL=YOUR_MAKE_COM_GROWTH_WEBHOOK_URL
MAKE_GROWTH_WEBHOOK_SECRET=YOUR_MAKE_GROWTH_WEBHOOK_SECRET

# Google Drive upload for generated images (shared/storage/google_drive.py) --
# without this, daily_cycle still queues text-only publications (best-effort,
# no crash), but Make.com never receives an image_url to attach to the post.
# GOOGLE_DRIVE_TOKEN_JSON is a full authorized_user-format OAuth token JSON
# blob (NOT the client secret) -- reuses the same Google Cloud OAuth app as
# venho-social-content-agent/google_drive.py; run that repo's one-time
# `python3 google_drive.py` local browser-consent flow to mint a token, then
# paste the resulting token.json content here as one line.
GOOGLE_DRIVE_TOKEN_JSON=YOUR_GOOGLE_DRIVE_AUTHORIZED_USER_TOKEN_JSON
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

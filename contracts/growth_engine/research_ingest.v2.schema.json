{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Growth Engine Research Candidate Ingest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source",
    "external_key",
    "source_revision",
    "topic_key",
    "expires_at_ms",
    "payload"
  ],
  "properties": {
    "schema_version": {"const": "growth.research_ingest.v2"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source": {"type": "string", "minLength": 1, "maxLength": 128},
    "external_key": {"type": "string", "minLength": 1, "maxLength": 512},
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "topic_key": {"type": "string", "minLength": 1, "maxLength": 512},
    "event_key": {"type": ["string", "null"], "maxLength": 512},
    "event_start_at_ms": {"type": ["integer", "null"], "minimum": 0},
    "event_end_at_ms": {"type": ["integer", "null"], "minimum": 0},
    "expires_at_ms": {"type": "integer", "minimum": 0},
    "payload": {"type": "object"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://venho.local/contracts/identity_pack_v1/1.0",
  "title": "Identity Pack V1",
  "description": "Human-approved identity references for Candidate v3 restoration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identityPackId",
    "identitySubjectId",
    "status",
    "references",
    "sha256"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "identityPackId": { "type": "string", "minLength": 1 },
    "identitySubjectId": { "const": "linh-an" },
    "status": { "enum": ["DRAFT", "APPROVED", "RETIRED"] },
    "approvedAt": { "type": "string", "format": "date-time" },
    "approvedBy": { "type": "string", "minLength": 1 },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/IdentityReferenceV1" }
    },
    "sha256": { "$ref": "#/$defs/Sha256" }
  },
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "IdentityReferenceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceId",
        "artifactPath",
        "artifactSha256",
        "role",
        "pose",
        "faceBounds",
        "usableRegions",
        "consentOrAuthorityRef",
        "approved"
      ],
      "properties": {
        "referenceId": { "type": "string", "minLength": 1 },
        "artifactPath": { "type": "string", "minLength": 1 },
        "artifactSha256": { "$ref": "#/$defs/Sha256" },
        "role": {
          "enum": ["PRIMARY_FRONTAL", "THREE_QUARTER", "PROFILE"]
        },
        "pose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["yawDeg", "pitchDeg", "rollDeg", "toleranceDeg"],
          "properties": {
            "yawDeg": { "type": "number" },
            "pitchDeg": { "type": "number" },
            "rollDeg": { "type": "number" },
            "toleranceDeg": { "type": "number", "minimum": 0 }
          }
        },
        "faceBounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "top", "right", "bottom"],
          "properties": {
            "left": { "type": "number", "minimum": 0 },
            "top": { "type": "number", "minimum": 0 },
            "right": { "type": "number", "minimum": 0 },
            "bottom": { "type": "number", "minimum": 0 }
          }
        },
        "usableRegions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["eyes", "nose", "mouth", "jaw", "hairline"]
          }
        },
        "consentOrAuthorityRef": { "type": "string", "minLength": 1 },
        "approved": { "type": "boolean" }
      }
    }
  }
}

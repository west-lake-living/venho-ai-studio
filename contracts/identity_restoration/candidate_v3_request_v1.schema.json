{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://venho.local/contracts/candidate_v3_request_v1/1.0",
  "title": "Candidate V3 Restoration Request V1",
  "description": "Internal canonical restoration request for the Candidate v3 pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "runId",
    "attemptId",
    "canonicalImage",
    "canonicalEditableMask",
    "canonicalFeatherMask",
    "transform",
    "selectedIdentityReferences",
    "candidateProfileId",
    "seed",
    "effectiveConfigSha256",
    "timeoutSeconds"
  ],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "runId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "canonicalImage": { "$ref": "#/$defs/CanonicalArtifactRef" },
    "canonicalEditableMask": { "$ref": "#/$defs/CanonicalArtifactRef" },
    "canonicalFeatherMask": { "$ref": "#/$defs/CanonicalArtifactRef" },
    "transform": { "$ref": "#/$defs/CanonicalFaceTransform" },
    "selectedIdentityReferences": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ArtifactRef" }
    },
    "candidateProfileId": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "effectiveConfigSha256": { "$ref": "#/$defs/Sha256" },
    "timeoutSeconds": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "width", "height", "mimeType"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "mimeType": { "enum": ["image/png", "application/json"] }
      }
    },
    "CanonicalArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "width", "height", "mimeType"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "width": { "const": 512 },
        "height": { "const": 512 },
        "mimeType": { "enum": ["image/png", "application/json"] }
      }
    },
    "BoundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "number" },
        "top": { "type": "number" },
        "right": { "type": "number" },
        "bottom": { "type": "number" }
      }
    },
    "CanonicalFaceTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sourceImage",
        "canvasCropBox",
        "modelSize",
        "landmarkSet",
        "forwardMatrix3x3",
        "inverseMatrix3x3",
        "borderMode",
        "interpolation",
        "transformSha256"
      ],
      "properties": {
        "version": { "const": "1.0" },
        "sourceImage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "sha256"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/Sha256" }
          }
        },
        "canvasCropBox": { "$ref": "#/$defs/BoundingBox" },
        "modelSize": { "const": 512 },
        "landmarkSet": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "confidence"],
            "properties": {
              "x": { "type": "number", "minimum": 0 },
              "y": { "type": "number", "minimum": 0 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "forwardMatrix3x3": { "$ref": "#/$defs/Matrix3x3" },
        "inverseMatrix3x3": { "$ref": "#/$defs/Matrix3x3" },
        "borderMode": { "const": "REFLECT_101" },
        "interpolation": { "const": "LANCZOS4" },
        "transformSha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "Matrix3x3": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "type": "number" }
    }
  }
}

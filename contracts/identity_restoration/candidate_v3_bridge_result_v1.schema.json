{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://venho.local/contracts/candidate_v3_bridge_result_v1/1.0",
  "title": "Candidate V3 Bridge Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["restoredCanonical", "lineage"],
  "properties": {
    "restoredCanonical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "width", "height", "mimeType"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width": { "const": 512 },
        "height": { "const": 512 },
        "mimeType": { "const": "image/png" }
      }
    },
    "lineage": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    }
  }
}

{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ResearchNoteFrontmatter","type":"object","required":["rs_id","type","domain","evidence_level","status","collected_at","confidence","promoted_fact_keys","related_briefs","verified_by_human","tags"],"properties":{"rs_id":{"type":"string","pattern":"^RS-[0-9]{4}-[0-9]{2}-[0-9]{4}$"},"type":{"enum":["source","note","synthesis","insight","event","trend"]},"domain":{"enum":["guest_voice","competitor","local_intel","platform_trend","brand_visual","market_pricing","social_trend","local_events"]},"evidence_level":{"enum":["R0","R1","R2","R2-T","R3"]},"status":{"enum":["draft","reviewed","promoted","archived"]},"collected_at":{"type":"string"},"source_uri":{"type":["string","null"]},"confidence":{"type":"number","minimum":0,"maximum":1},"expires_at":{"type":["string","null"]},"promoted_fact_keys":{"type":"array","items":{"type":"string"}},"related_briefs":{"type":"array","items":{"type":"string"}},"verified_by_human":{"type":"boolean"},"tags":{"type":"array","items":{"type":"string"}}},"additionalProperties":true,"allOf":[{"if":{"properties":{"type":{"const":"source"}}},"then":{"required":["source_uri"]}},{"if":{"properties":{"evidence_level":{"enum":["R2","R2-T"]}}},"then":{"required":["expires_at"]}},{"if":{"properties":{"type":{"const":"event"}}},"then":{"required":["event_name","event_start","event_end","venue","expires_at","verified_by_human"]}}]}
